APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Berlin
APP_NAME=Henz Software Solutions

DB_DEFAULT=mysql
DB1_HOST=127.0.0.1
DB1_PORT=3306
DB1_DATABASE=<DATABASE>
DB1_USERNAME=<USERNAME>
DB1_PASSWORD=<PASSWORD>
DB1_CHARSET=utf8mb4
DB1_COLLATION=utf8mb4_unicode_ci

DB2_HOST=127.0.0.1
DB2_PORT=3306
DB2_DATABASE=<DATABASE>
DB2_USERNAME=<USERNAME>
DB2_PASSWORD=<PASSWORD>
DB2_CHARSET=utf8mb4
DB2_COLLATION=utf8mb4_unicode_ci

LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# Mail infrastructure
MAIL_PROVIDER=strato
MAIL_TRANSPORT=smtp
EMAIL_AUTOMATION_ENABLED=true
MAIL_HOST=smtp.strato.de
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=info@henz-software.com
MAIL_PASSWORD=<PASSWORD>
MAIL_TIMEOUT_SECONDS=10
MAIL_EMBED_INLINE_IMAGES=false

MAIL_FROM_COMMUNICATION=info@henz-software.com
MAIL_FROM_COMMUNICATION_NAME=Henz Software Solutions

MAIL_FROM_NOREPLY=noreply@henz-software.com
MAIL_FROM_NOREPLY_NAME=Henz Software Solutions

MAIL_FROM_SUPPORT=support@henz-software.com
MAIL_FROM_SUPPORT_NAME=Henz Software Solutions Support

MAIL_LOG_CHANNEL=app

SESSION_RECORD_ENCRYPTION_KEY=<KEY>
SESSION_RECORD_ENCRYPTION_KEY_VERSION=1