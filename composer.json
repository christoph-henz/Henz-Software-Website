{
    "name": "getragen-begleiten/backend-foundation",
    "description": "Framework-unabhängiges, erweiterbares PHP Backend-Grundgeruest",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Controllers\\Api\\": "api/"
        },
        "files": [
            "app/Core/Support/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": [
            "@test:lint",
            "@test:admin-clients",
            "@test:admin-bookings",
            "@test:payment-reminders"
        ],
        "test:lint": "php -l public/index.php",
        "test:admin-clients": "php tests/ClientAdminEndpointSmokeTest.php",
        "test:admin-bookings": "php tests/BookingAdminEndpointSmokeTest.php",
        "test:payment-reminders": "php tests/PaymentReminderCronEndpointSmokeTest.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
